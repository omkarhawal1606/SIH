# Wanderly AI Travel Planner - Environment Variables
# Copy this to .env.local for local development
# Add these to Vercel (Settings > Environment Variables)

# ─────────────────────────────────────────────────────
# Multi-Agent AI Travel Architecture (4 Dedicated Agents)
# If any agent key is left blank, it automatically falls back to GEMINI_API_KEY.
# ─────────────────────────────────────────────────────

# Base Gemini API Key (General fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# AGENT 1 — Travel Planner & Itinerary Agent (Itinerary, attractions, daily schedules)
GEMINI_TRAVEL_PLANNER_API_KEY=your_agent1_key_here

# AGENT 2 — Stay, Food & Experience Agent (Hotels, dining, authentic cuisine, local experiences)
GEMINI_STAY_FOOD_API_KEY=your_agent2_key_here

# AGENT 3 — Transport, Budget & Safety Agent (Transit routes, budget allocation, safety checks)
GEMINI_TRANSPORT_SAFETY_API_KEY=your_agent3_key_here

# AGENT 4 — Travel Intelligence & Verification Agent (Validation, conflict resolution, Cultural & Heritage dossiers)
GEMINI_TRAVEL_INTELLIGENCE_API_KEY=your_agent4_key_here

# (Legacy / alternative alias for Agent 4 cultural features)
GEMINI_CULTURE_API_KEY=your_gemini_culture_api_key_here

# OpenWeatherMap API Key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ─────────────────────────────────────────────────────
# Firebase Configuration
# Get these from Firebase Console > Project Settings > Your Apps > Web App
# https://console.firebase.google.com/
# ─────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Optional: Override the site URL for auth email redirect targets
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
